# =============================================================================
# EduPulse RAG System — Environment Variables Template
# Copy to .env (`cp .env.example .env`) and fill in secrets before running.
# =============================================================================

# --- Mandatory Secrets (Docker Compose fails fast if empty) ---
POSTGRES_PASSWORD=changeme
LLM_API_KEY=your_gemini_key
VENDOR_WEBHOOK_SECRET=your_hmac_secret

# --- Optional / External API Keys ---
# If empty, retrieval-post logs a warning and falls back to vector similarity order.
COHERE_API_KEY=

# --- PostgreSQL / pgvector ---
POSTGRES_USER=postgres
POSTGRES_DB=edupulse
POSTGRES_HOST_PORT=5433
# Max 2000 for pgvector HNSW index; standardized to 1536 across all services.
EMBEDDING_DIMENSIONS=1536

# --- AI Models (Google AI Studio) ---
LLM_CHAT_MODEL=gemini-3.5-flash-lite
LLM_EMBEDDING_MODEL=gemini-embedding-001

# --- Ingestion (Story 1 & Story 2) ---
APP_CHUNK_SIZE=512
APP_CHUNK_OVERLAP=64
APP_STATIC_RESOURCES_DIR=/app/resources
APP_WATCHER_INTERVAL_SEC=30
APP_WATCHER_RESOURCES_DIR=/app/resources
APP_INGEST_MAX_BYTES=20971520
APP_INGEST_TIMEOUT_MS=10000
APP_INGEST_BLOCK_PRIVATE_NETWORKS=true
APP_INGEST_ALLOWED_DOMAINS=kubernetes.io,github.com,raw.githubusercontent.com,cncf.io

# --- Pre-Retrieval (Story 3) ---
APP_MULTI_QUERY_VARIANTS=3
APP_MULTI_QUERY_TIMEOUT_MS=1500
APP_ACRONYMS_RESOURCE=classpath:acronyms.yml

# --- Post-Retrieval & Evaluation (Story 4) ---
APP_RERANK_TOP_N=20
APP_RERANK_TOP_K=5
APP_RERANK_MODEL=rerank-v3.5
APP_RERANK_TIMEOUT_MS=3000
APP_TOKEN_BUDGET=2500
APP_SIMILARITY_THRESHOLD=0.65
APP_EVAL_GOLDEN_SET_RESOURCE=classpath:eval/golden-set.json
